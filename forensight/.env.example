# Local backend configuration. Export these variables in your shell before starting FastAPI.
DATABASE_URL=sqlite:///forensight.db
FORENSIGHT_MODE=offline
FORENSIGHT_USER=local
NIGHTFALL_DATA_DIR=data/nightfall
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
# Optional regular expression for approved preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
# Frontend build-time value. Leave blank when serving frontend from the backend itself.
VITE_API_URL=
# Optional: enables LLM rephrasing of already-grounded answers. App works without it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
